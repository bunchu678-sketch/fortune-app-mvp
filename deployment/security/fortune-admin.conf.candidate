# Candidate only. Confirm DNS, issue each certificate and run nginx -t before use.
# The B2C app.hakase-uranai.jp virtual host is deliberately outside this file.
server {
    listen 80;
    server_name admin.hakase-uranai.jp;
    server_tokens off;
    access_log off;
    location ^~ /.well-known/acme-challenge/ { root /var/www/fortune-admin-acme; default_type text/plain; }
    location / { return 301 https://admin.hakase-uranai.jp$request_uri; }
}
server {
    listen 443 ssl;
    server_name admin.hakase-uranai.jp;
    include /etc/nginx/snippets/fortune-security-admin.conf;
    ssl_certificate /etc/letsencrypt/live/admin.hakase-uranai.jp/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.hakase-uranai.jp/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    client_max_body_size 10m;
    location = / { return 302 /operations; }
    location /api/ {
        proxy_pass http://127.0.0.1:8772;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
    location ~ ^/(operations(/.*)?|login|forgot-password|reset-password|mypage|_next/.*|favicon\.ico)$ {
        proxy_pass http://127.0.0.1:3011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
    location / { return 404; }
}
