# Optional only: preserve password-reset mail after explicit operational approval.
# PID 1 reads these sources; the API receives only these two private snapshots.
[Service]
LoadCredential=smtp-config:@EXISTING_SMTP_CONFIG_SOURCE@
LoadCredential=smtp-password:@SMTP_PASSWORD_SOURCE@
RuntimeDirectory=fortune-mari-reading-mail
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
Environment=FORTUNE_RESET_MAIL_CONFIG=/run/fortune-mari-reading-mail/smtp-config
ExecStartPre=@PYTHON@ -B @RELEASE@/deployment/mari-prototype/materialize_mail.py
